# Скопируйте этот файл в .env.local и подставьте реальные значения.
# .env.local в репозиторий НЕ коммитится (см. .gitignore).

# Telegram-бот для заявок с сайта
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Канонический адрес сайта (для метаданных / redirect'ов)
NEXT_PUBLIC_SITE_URL=https://gravitydance.ru
